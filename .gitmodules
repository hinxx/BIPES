# Runtime submodules -- iframed by ui/index.html, needed to run the IDE.
# Upstream pointed these at git@github.com:joaodrj/*, which no longer exists
# (and required an SSH key). The repos live under the BIPES org over HTTPS.
[submodule "ui/freeboard"]
	path = ui/freeboard
	url = https://github.com/BIPES/freeboard.git
[submodule "databoard"]
	path = databoard
	url = https://github.com/BIPES/Databoard.git

# Build-time submodules -- only needed to regenerate the vendored copies in
# ui/core via `make copy`. Not required to run the IDE.
#
# blockly is a reference copy only -- `make copy` takes the compiled bundles
# from the npm package, because since v10 they are build output and are not
# committed to this repository at all. Keep it pinned to the same tag as
# BLOCKLY_VERSION in the Makefile so that `git -C blockly show <path>` is the
# readable source for whatever is vendored in ui/core.
#
# Blockly moved from Google to the Raspberry Pi Foundation; the old URL still
# redirects, but this is where it lives now.
[submodule "blockly"]
	path = blockly
	url = https://github.com/RaspberryPiFoundation/blockly.git
[submodule "webrepl"]
	path = webrepl
	url = https://github.com/micropython/webrepl.git
